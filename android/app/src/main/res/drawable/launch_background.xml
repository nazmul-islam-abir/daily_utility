<?xml version="1.0" encoding="utf-8"?>
<!-- Branded launch screen for Daily Utility: indigo→violet gradient with
     the app logo centered. Shown by the OS before Flutter draws its first
     frame; replaced by the Flutter splash once it boots. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#3D5AFE"
                android:centerColor="#5046E5"
                android:endColor="#7C3AED" />
        </shape>
    </item>
    <item android:gravity="center">
        <bitmap android:gravity="center" android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
